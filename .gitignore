# ============================================
# Sortyx 2.0 — .gitignore
# ============================================

# ----- Environment & Secrets -----
.env
.env.local
.env.production
.env.*.local
*.pem
*.key
*.secret

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ----- Build outputs -----
frontend/dist/
backend/dist/
*.build/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ----- OS -----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ----- Testing -----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ----- Logs -----
logs/
*.log

# ----- Temporary files -----
tmp/
temp/
*.tmp

# ----- Captured images (NEVER store) -----
captures/
images/
snapshots/

# ----- Hardware config with secrets -----
config/hardware.yaml
config/application.yaml

