# Sortyx 2.0 Backend Environment Configuration
# Copy this file to .env and fill in actual values

# AI Provider: CLOUD_RUN
AI_PROVIDER=CLOUD_RUN

# Sortyx Cloud Run AI API (Reuses existing Sortyx Vertex AI deployment)
CLOUD_RUN_ENDPOINT=https://sortyx-classify-5bwsw4lr6q-uc.a.run.app/api/classify
CLOUD_RUN_TIMEOUT=15.0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# Device Authentication
DEVICE_API_SECRET=your_device_secret_here

# External Logitech USB Webcam Configuration
CAMERA_TYPE=USB_WEBCAM
CAMERA_SOURCE=WEBCAM
CAMERA_INDEX=0
CAMERA_ALT_INDICES=1,2
CAMERA_BACKEND=v4l2
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_AUTO_RECONNECT=true

# GPIO Pin Configuration (BCM numbering only)
GPIO_NUMBERING=BCM

# Bin 1 (Organic) Ultrasonic Sensor
ULTRASONIC_TRIG_1=17
ULTRASONIC_ECHO_1=24

# Bin 2 (Bio) Ultrasonic Sensor
ULTRASONIC_TRIG_2=22
ULTRASONIC_ECHO_2=27

# Bin 3 (Non-Bio) Ultrasonic Sensor
ULTRASONIC_TRIG_3=23
ULTRASONIC_ECHO_3=6

ULTRASONIC_SAMPLES=1
ULTRASONIC_TIMEOUT_S=0.1
SENSOR_READ_INTERVAL_S=10

# Bin 1 (Organic) Load Cell (HX711)
HX711_DT_1=5
HX711_SCK_1=11

# Bin 2 (Bio) Load Cell (HX711)
HX711_DT_2=13
HX711_SCK_2=19

# Bin 3 (Non-Bio) Load Cell (HX711)
HX711_DT_3=26
HX711_SCK_3=21

# HX711 Calibration Offsets (leave empty until calibrated)
HX711_TARE_1=
HX711_TARE_2=
HX711_TARE_3=

HX711_SCALE_1=
HX711_SCALE_2=
HX711_SCALE_3=

# Weight rule disabled
WEIGHT_RULE=false

# PCA9685 I2C Servo Controller
PCA9685_I2C_BUS=1
PCA9685_ADDRESS=0x40
SERVO_PWM_HZ=50

SERVO_OPEN_DEG=50
SERVO_CLOSE_DEG=0

SERVO_HOLD_S=3.0
SERVO_SETTLE_S=0.5

SERVO_RANGE_DEG=180

SERVO_CHANNEL_1=0
SERVO_CHANNEL_2=1
SERVO_CHANNEL_3=2

# Application Behavior & Safety
LOG_LEVEL=INFO
SIMULATION_MODE=true
